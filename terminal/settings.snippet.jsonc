// Windows Terminal appearance used in the README.
// Settings -> Open JSON file, then merge the keys under profiles.defaults.
// Needs a Nerd Font (MesloLGL Nerd Font Mono matches the shots).
{
  "profiles": {
    "defaults": {
      "colorScheme": "Tango Dark",
      "font": {
        "face": "MesloLGL Nerd Font Mono",
        "size": 13
      },
      "opacity": 65,
      "useAcrylic": true
    }
  },
  "useAcrylicInTabRow": true
}
